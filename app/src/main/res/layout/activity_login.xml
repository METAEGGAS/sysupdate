<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ══════════ صفحة اللوجين ══════════ -->
    <ScrollView
        android:id="@+id/loginView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_radial"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="26dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp">

                <!-- اللوجو: لو عندك صورة اللوجو حطها في drawable باسم ic_logo
                     واستبدل الـ TextView ده بـ ImageView ارتفاعه 40dp -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="ExCoreX"
                    android:textColor="#3d8bff"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Badge: أيقونة البيت + النص -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Trade cryptocurrencies anytime"
                        android:textColor="#dbe7ff"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- العنوان (كلمة cryptocurrency بتتلون أزرق من الكود) -->
                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.25"
                    android:text="Power up your\ncryptocurrency\njourney"
                    android:textColor="#ffffff"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- صورة العملة — بتتداخل فوق الكارت بـ -32dp زي auth.html -->
                <ImageView
                    android:layout_width="290dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="-32dp"
                    android:adjustViewBounds="true"
                    android:translationZ="10dp"
                    android:src="@drawable/ic_coin" />
            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_top_curve"
                android:paddingTop="73dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="36dp">

                <!-- Tabs -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/tE"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#ffffff"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="2dp"
                        android:paddingEnd="26dp" />

                    <TextView
                        android:id="@+id/tP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone"
                        android:textColor="@color/text_dim"
                        android:textSize="16.5sp"
                        android:textStyle="bold"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/idIn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input">

                    <EditText
                        android:id="@+id/pw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="48dp"
                        android:textColor="#e8eef8"
                        android:textColorHint="@color/text_dim"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/eye"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="15dp"
                        android:src="@drawable/ic_eye_off" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <EditText
                        android:id="@+id/capIn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Please enter the verification code"
                        android:inputType="text"
                        android:textColor="#e8eef8"
                        android:textColorHint="@color/text_dim"
                        android:textSize="15sp" />

                    <com.sys.update2.CaptchaView
                        android:id="@+id/cap"
                        android:layout_width="88dp"
                        android:layout_height="40dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_primary"
                    android:text="Log In"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGoReset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="reset pass"
                        android:textColor="#8fa3c8"
                        android:textSize="14sp"
                        android:paddingVertical="8dp" />

                    <TextView
                        android:id="@+id/btnGoRegister"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="to register"
                        android:textColor="#8fa3c8"
                        android:textSize="14sp"
                        android:paddingVertical="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══════════ صفحة Register ══════════ -->
    <ScrollView
        android:id="@+id/registerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_reg_gradient"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/backFromReg"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_back_btn"
                    android:padding="9dp"
                    android:src="@drawable/ic_back_arrow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Email"
                    android:textColor="#ffffff"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <EditText
                android:id="@+id/rEm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg"
                android:hint="Please enter your email address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#e8eef8"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Verification code"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/rVc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Please enter the verification code"
                    android:inputType="number"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/rSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="Send"
                    android:textColor="#dce8ff"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Registration password (6-16)"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg">

                <EditText
                    android:id="@+id/rP1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/rEye1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_reg">

                <EditText
                    android:id="@+id/rP2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Enter password again"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/rEye2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Referrer Invitation Code (Required)"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <EditText
                android:id="@+id/rRef"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg"
                android:hint="Referrer invitation code"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="16dp"
                android:textColor="#e8eef8"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_btn_primary_reg"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGoLoginFromReg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="To log in"
                android:textColor="#8ba5d9"
                android:textSize="14.5sp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ══════════ صفحة Reset Password ══════════ -->
    <ScrollView
        android:id="@+id/resetView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_reg_gradient"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/backFromReset"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_back_btn"
                    android:padding="9dp"
                    android:src="@drawable/ic_back_arrow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Reset Password"
                    android:textColor="#ffffff"
                    android:textSize="17.5sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="38dp"
                    android:layout_height="38dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <EditText
                android:id="@+id/fEm"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg"
                android:hint="Please enter your email address"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#e8eef8"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Verification code"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/fVc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Please enter the verification code"
                    android:inputType="number"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/fSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:text="Send"
                    android:textColor="#dce8ff"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="New password (6-16)"
                android:textColor="#eaf0fb"
                android:textSize="14.5sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_input_reg">

                <EditText
                    android:id="@+id/fP1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Enter new password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:textColor="#e8eef8"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/fEye"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/ic_eye_off" />
            </FrameLayout>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_btn_primary_reg"
                android:text="Confirm"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="16.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
